{
  "imports": {
    "std/encoding/hex": "jsr:@std/encoding/hex",
    "@oak/oak": "jsr:@oak/oak"
  },
  "tasks": {
    "run": "deno run --allow-read --allow-write --allow-net --allow-env src/cli.ts",
    "serve": "deno run --allow-read --allow-write --allow-net --allow-env src/server.ts",
    "client": "deno run --allow-read --allow-write --allow-net --allow-env src/thin-client.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["src"]
    }
  },
  "fmt": {
    "files": {
      "include": ["src"]
    }
  }
}
